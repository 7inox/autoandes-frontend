        {
          "name": "1. Login (admin / asesor / jefe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "200 - respuesta observada",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": "{{baseUrl}}/auth/login",
                "auth": {
                  "type": "noauth"
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"tipo\": \"Bearer\",\n  \"expiraEnSegundos\": 3600,\n  \"nombreCompleto\": \"Administrador AutoAndes\",\n  \"roles\": [\n    \"ADMIN\"\n  ],\n  \"permisos\": [\n    \"ORDEN_ANULAR\",\n    \"ORDEN_LEER\",\n    \"ORDEN_REGISTRAR\",\n    \"REPORTE_VER\",\n    \"SERVICIO_ESCRIBIR\",\n    \"SERVICIO_LEER\",\n    \"VEHICULO_ESCRIBIR\",\n    \"VEHICULO_LEER\"\n  ]\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login correcto',()=>pm.response.to.have.status(200));",
                  "const r=pm.response.json(); if(r.token) pm.collectionVariables.set('token',r.token);"
                ]
              }
            }
          ]
        },
