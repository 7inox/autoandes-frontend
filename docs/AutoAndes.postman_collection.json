{
  "info": {
    "name": "AutoAndes - Examen LP2 Tinoco",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API real Oracle. Ejemplos exportados de pruebas ejecutadas. Token se obtiene al hacer login; no se exporta ninguno activo. Atención: las operaciones de escritura crean datos reales. Use el test de integración para limpieza automática."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "username",
      "value": "admin"
    },
    {
      "key": "password",
      "value": "Auto2026*"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "servicioId",
      "value": ""
    },
    {
      "key": "vehiculoId",
      "value": ""
    },
    {
      "key": "ordenId",
      "value": ""
    }
  ],
